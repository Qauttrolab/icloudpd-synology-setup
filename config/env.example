# =============================================================================
# icloudpd Zugangsdaten — Docker Compose Root .env
# =============================================================================
# Ablage: /volume1/docker/icloudpd/.env
# Berechtigungen: chmod 600 /volume1/docker/icloudpd/.env
#
# Diese Datei wird von Docker Compose automatisch eingelesen.
# Variablen werden in compose.yaml als ${ICLOUD_USER_ACCOUNT1} referenziert.
#
# App-spezifisches Passwort erstellen:
#   → appleid.apple.com → Sicherheit → App-spezifische Passwörter → +
#   → Name: icloudpd
#   → Format: xxxx-xxxx-xxxx-xxxx
#
# WICHTIG: Niemals das normale Apple ID Passwort verwenden!
# =============================================================================

# ---------------------------------------------------------------------------
# ACCOUNT 1 — aktiv
# ---------------------------------------------------------------------------
ICLOUD_USER_ACCOUNT1=appleID@example.com
ICLOUD_PASS_ACCOUNT1=xxxx-xxxx-xxxx-xxxx

# ---------------------------------------------------------------------------
# ACCOUNT 2 — auskommentiert bis eingerichtet
# ---------------------------------------------------------------------------
# ICLOUD_USER_ACCOUNT2=appleID2@example.com
# ICLOUD_PASS_ACCOUNT2=xxxx-xxxx-xxxx-xxxx

# ---------------------------------------------------------------------------
# ACCOUNT 3 — auskommentiert bis eingerichtet
# ---------------------------------------------------------------------------
# ICLOUD_USER_ACCOUNT3=appleID3@example.com
# ICLOUD_PASS_ACCOUNT3=xxxx-xxxx-xxxx-xxxx
